# 実行環境（dev or prod）
ENV=dev
# ユーザID
USER_ID=1000
# グループID
GROUP_ID=1000
# ユーザ名
USER_NAME=komorilab
# サーバの公開IPアドレス
PUBLIC_IP=123.45.67.89
# サーバの公開IPアドレスに紐付けされているドメイン（なければ localhost 推奨）
DOMAIN=localhost
# API のアドミン操作を行えるクライアントの ID を指定（変更推奨）
ADMIN_CLIENT_ID=admin
# API のアドミン操作を行えるクライアントのパスワードを指定（変更推奨）
ADMIN_CLIENT_PASSWORD=password
# appコンテナがアクセスを待ち受けるIPアドレスを指定
APP_HOST=0.0.0.0
# appコンテナのポート番号
APP_PORT=8888
# 関連ファイルを保存するディレクトリの名前
STORAGE_DIRECTORY_NAME=storage
# パスワードのハッシュ化キー
HASH_KEY=hash
# JWTトークンのシークレットキー（変更推奨）
JWT_SECRET_KEY=secret_key
# JWTトークンのアルゴリズム
JWT_ALGORITHM=HS256
# JWTトークンの生存時間を指定
JWT_EXPIRE_MINUTES=15
# JWTリフレッシュトークンのシークレットキー（変更推奨）
JWT_REFRESH_SECRET_KEY=refresh_secret_key
# JWTリフレッシュトークンのアルゴリズム
JWT_REFRESH_ALGORITHM=HS256
# JWTリフレッシュトークンの生存時間を指定
JWT_REFRESH_EXPIRE_MINUTES=43200
# PostgreSQL のホスト名を指定（postgresql 推奨）
POSTGRESQL_HOST=database
# PostgreSQL のポート番号を指定（競合する場合は変更必須）
POSTGRESQL_PORT=5432
# PostgreSQL の root ユーザのパスワードを指定（変更推奨）
POSTGRESQL_ROOT_PASSWORD=root
# PostgreSQL の使用するデータベース名を指定
POSTGRESQL_DATABASE=db
# PostgreSQL のユーザ名を指定（変更推奨）
POSTGRESQL_USER=user
# PostgreSQL のユーザのパスワードを指定（変更推奨）
POSTGRESQL_PASSWORD=password
# Redis のコンテナ名
REDIS_HOST=redis
# Redis のポート番号
REDIS_PORT=6379
# Redis のDB番号
REDIS_DB=0
# Coturn のユーザ名を指定（変更推奨）
COTURN_USERNAME=user
# Coturn のユーザのパスワードを指定（変更推奨）
COTURN_PASSWORD=password
# Coturn の使用するシークレットを指定（変更推奨）
COTURN_SECRET=sercret
# Coturn の使用するポート番号範囲の最小値を指定（競合する場合は変更必須）
COTURN_MIN_PORT=49152
# Coturn の使用するポート番号範囲の最大値を指定（競合する場合は変更必須）
COTURN_MAX_PORT=49252
# Coturn の使用するポート番号を指定（競合する場合は変更必須）
COTURN_PORT=5349
# Coturn の使用するユーザ名を指定（変更推奨）
COTURN_USERNAME=user
# Coturn の使用するパスワードを指定（変更推奨）
COTURN_CREDENTIAL=password
# Coturn の生成する認証情報の生存時間を指定
COTURN_TTL=86400
